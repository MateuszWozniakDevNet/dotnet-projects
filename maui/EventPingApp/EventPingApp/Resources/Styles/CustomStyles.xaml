<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <Style x:Key="labelCustomStyle" TargetType="Label">
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Offset="5,5" Radius="0" Opacity="0.1" />
        </Setter>
    </Style>

    <Style x:Key="LabelValidationErrorStyle" TargetType="Label">
        <Setter Property="TextColor" Value="Red" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <Style x:Key="EntryCustomStyle" TargetType="Entry">
        <Setter Property="Placeholder" Value="" />
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="MaxLength" Value="60" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
        <Setter Property="TextTransform" Value="Default" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
        <Setter Property="Keyboard">
            <Keyboard x:FactoryMethod="Create">
                <x:Arguments>
                    <KeyboardFlags>CapitalizeWord</KeyboardFlags>
                </x:Arguments>
            </Keyboard>
        </Setter>
    </Style>

    <Shadow x:Key="CardShadow" Brush="Gray" Offset="0,4"  Radius="8" />

</ResourceDictionary>
